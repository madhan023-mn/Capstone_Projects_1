{
  "name": "collaborative-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Real-Time Collaborative Workspace (Notion/Figma Style) with Next.js, TipTap, Yjs, WebSockets, PostgreSQL, Prisma, and Redis",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "collab": "node collaboration-server/server.js",
    "db:start": "node scripts/start-postgres.js",
    "db:verify": "node scripts/verify-db.js",
    "dev:all": "concurrently -n \"NEXT,COLLAB\" -c \"blue,green\" \"npm run dev\" \"npm run collab\"",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:load": "node scripts/load-test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@tiptap/extension-collaboration": "^2.6.6",
    "@tiptap/extension-collaboration-cursor": "^2.6.6",
    "@tiptap/extension-highlight": "^2.6.6",
    "@tiptap/extension-placeholder": "^2.6.6",
    "@tiptap/extension-task-item": "^2.6.6",
    "@tiptap/extension-task-list": "^2.6.6",
    "@tiptap/extension-underline": "^2.6.6",
    "@tiptap/pm": "^2.6.6",
    "@tiptap/react": "^2.6.6",
    "@tiptap/starter-kit": "^2.6.6",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.446.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.18",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.12",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.0",
    "vitest": "^2.1.2"
  }
}
